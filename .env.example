# Server-only database connection. Create a deployment at https://www.mongodb.com/atlas
# or use a local MongoDB replica set for transaction support.
MONGO_URL=mongodb://127.0.0.1:27017/mask_merch

# Google OAuth credentials from https://console.cloud.google.com/apis/credentials.
# Add http://localhost:3000/api/auth/callback/google as a development redirect URI.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Generate with: npx auth secret
AUTH_SECRET=
# Canonical app URL. Change to the deployed HTTPS origin in production.
AUTH_URL=http://localhost:3000
# Required when deployed behind a trusted reverse proxy; review for your host.
AUTH_TRUST_HOST=true

# Comma-separated, server-only allow-list. These accounts may use /store/admin.
ADMIN_EMAILS=admin@example.com
# Replace every UPI placeholder before launch.
UPI_ID=replace-me@upi
UPI_RECIPIENT_NAME=MASK PAYMENT RECIPIENT
UPI_QR_IMAGE_URL=/assets/store/upi-placeholder.svg

# Payment proofs. "local" is DEVELOPMENT ONLY and stores files outside /public.
PAYMENT_PROOF_STORAGE=local
MAX_PAYMENT_PROOF_BYTES=5242880

# Production object storage adapter configuration (implement/configure before launch).
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Publicly displayed placeholders. Replace with confirmed MASK details.
NEXT_PUBLIC_MASK_CONTACT_EMAIL=replace-with-mask-contact@example.com
NEXT_PUBLIC_MASK_CONTACT_INSTAGRAM=https://www.instagram.com/maskiitkgp
